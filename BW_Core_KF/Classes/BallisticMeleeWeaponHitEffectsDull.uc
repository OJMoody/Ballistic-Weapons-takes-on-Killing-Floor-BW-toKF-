	HitEffects(15)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitMetalArmorEffect',HitSound=sound'KF_AxeSnd.Axe_HitMetal')     	// MetalArmor
	HitEffects(16)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitPaperEffect',HitSound=sound'KF_AxeSnd.Axe_HitDirt')       		// Paper

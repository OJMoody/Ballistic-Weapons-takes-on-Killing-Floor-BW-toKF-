	HitEffects(5)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitGrassEffect',HitSound=sound'KF_AxeSnd.Axe_HitDirt')      		// Plant
	HitEffects(6)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitFleshEffect',HitSound=sound'KF_AxeSnd.Axe_HitFlesh')        		// Flesh (dead animals)
	HitEffects(7)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitIceEffect',HitSound=sound'KF_AxeSnd.Axe_HitDirt')        		// Ice

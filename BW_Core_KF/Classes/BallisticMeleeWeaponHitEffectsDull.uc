defaultproperties
{
	HitEffects(0)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitRockEffect',HitSound=sound'KF_AxeSnd.Axe_HitDefault')        	// Default (Dirt?)
	HitEffects(1)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitRockEffect',HitSound=sound'KF_AxeSnd.Axe_HitDirt')     			// Rock

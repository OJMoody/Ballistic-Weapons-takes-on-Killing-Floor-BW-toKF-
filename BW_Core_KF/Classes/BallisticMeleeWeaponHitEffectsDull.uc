	HitEffects(10)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBreakingGlass',HitSound=sound'KF_AxeSnd.Axe_HitDefault')            		// Glass
	HitEffects(11)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitGravelEffect',HitSound=sound'KF_AxeSnd.Axe_HitDirt')     		// Gravel
	HitEffects(12)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitConcreteEffect',HitSound=sound'KF_AxeSnd.Axe_HitConc')    		// Concrete
	HitEffects(13)=(HitDecal=class'BallisticMeleeWeaponHitDecalDull',HitEffect=class'ROBulletHitWoodEffect',HitSound=sound'KF_AxeSnd.Axe_HitWood')       		// HollowWood
